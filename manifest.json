{
  "name": "Difup",
  "short_name": "Difup",
  "description": "Diffusez vos annonces automatiquement sur Facebook, Instagram et votre site internet.",
  "start_url": "./index.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#F4F7FB",
  "theme_color": "#2F6FE0",
  "lang": "fr",
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "share_target": {
    "action": "./share-target.html",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "title": "title",
      "text": "text",
      "url": "url",
      "files": [
        { "name": "shared_files", "accept": ["application/pdf", "image/*"] }
      ]
    }
  }
}
